{
  "name": "oa-lens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @oa-lens/extension dev",
    "dev:worker": "pnpm --filter @oa-lens/worker dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project core --coverage",
    "build": "pnpm --filter @oa-lens/extension zip && pnpm --filter @oa-lens/worker build",
    "deploy:worker": "pnpm --filter @oa-lens/worker run deploy",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ext:key": "node tools/ext-key.mjs",
    "ext:store": "pnpm --filter @oa-lens/extension zip --mode store",
    "ext:allow": "node tools/ext-allow.mjs",
    "verify:fees": "tsx tools/verify-fees.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oa-lens/core": "workspace:*",
    "@oa-lens/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}
