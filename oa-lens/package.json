{
  "name": "oa-lens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @oa-lens/extension dev",
    "dev:worker": "pnpm --filter @oa-lens/worker dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @oa-lens/extension zip && pnpm --filter @oa-lens/worker build",
    "deploy:worker": "pnpm --filter @oa-lens/worker run deploy",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ext:key": "node tools/ext-key.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}
