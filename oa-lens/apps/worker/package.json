{
  "name": "@oa-lens/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply oa-lens --local",
    "db:migrate:remote": "wrangler d1 migrations apply oa-lens --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oa-lens/core": "workspace:*",
    "@oa-lens/shared": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "wrangler": "^4.149.0"
  }
}
